# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PowerShell files require UTF-8 with BOM and CRLF
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

# Windows batch files
[*.{cmd,bat}]
charset = utf-8-bom
end_of_line = crlf

# Shell scripts
[*.sh]
charset = utf-8
end_of_line = lf

# Markdown files
[*.{md,markdown}]
trim_trailing_whitespace = false

# YAML files
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# JavaScript/TypeScript
[*.{js,ts,jsx,tsx}]
indent_size = 2
