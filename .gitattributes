# Auto detect text files and perform LF normalization
* text=auto

# PowerShell scripts with UTF-8 BOM and CRLF
*.ps1 text eol=crlf working-tree-encoding=UTF-8

# Shell scripts with LF
*.sh text eol=lf

# Windows batch files with CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Markdown files
*.md text eol=lf
*.markdown text eol=lf

# Source code files
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
