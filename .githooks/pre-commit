#!/usr/bin/env bash
# ==============================================================================
# Pre-commit hook: regenerate developer docs, run shellcheck + markdownlint.
# ==============================================================================
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Only regenerate if dev-tools.conf or the plugin/MCP configs changed
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if echo "$CHANGED" | grep -qE '^(config/dev-tools\.conf|config/plugins\.conf|config/mcp\.conf|scripts/generate-dev-docs\.sh)$'; then
    echo "=== Pre-commit: config changed — regenerating developer docs ==="
    bash "$SCRIPT_DIR/scripts/generate-dev-docs.sh"
    git add "$SCRIPT_DIR/docs/developer-tools.md" "$SCRIPT_DIR/docs/developer-tools.uk.md" 2>/dev/null || true
fi

# Run shellcheck on staged .sh files
SH_FILES=$(echo "$CHANGED" | grep -E '\.sh$' | tr '\n' ' ')
if [ -n "$SH_FILES" ]; then
    if command -v shellcheck &>/dev/null; then
        echo ">>> Running shellcheck on staged scripts <<<"
        cd "$SCRIPT_DIR"
        if ! shellcheck --severity=warning $SH_FILES; then
            echo ""
            echo "[FAIL] Shellcheck reported warnings. Fix before commit."
            echo "To skip (not recommended): git commit --no-verify"
            exit 1
        fi
        echo "Shellcheck: no issues found"
    else
        echo "[WARN] shellcheck not installed — skipping lint"
    fi
fi

# Run markdownlint on all .md files (catches regressions early)
if command -v markdownlint-cli2 &>/dev/null; then
    echo ">>> Running markdownlint on all markdown files <<<"
    cd "$SCRIPT_DIR"
    if ! markdownlint-cli2 "*.md" "**/*.md" "#node_modules"; then
        echo ""
        echo "[FAIL] Markdownlint reported errors. Fix before commit."
        echo "To skip (not recommended): git commit --no-verify"
        exit 1
    fi
    echo "Markdownlint: no issues found"
else
    echo "[WARN] markdownlint-cli2 not installed — skipping lint"
fi

exit 0
