#!/usr/bin/env bash
# ==============================================================================
# Pre-push hook: run full CI (Docker tests) before pushing to main/master
# Only triggers when *.sh or *.ps1 files change.
# ==============================================================================
set -euo pipefail

REMOTE="$1"
URL="$2"

while read local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
            cd "$SCRIPT_DIR"

            # Determine which files changed in this push
            if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
                # Pushing a new branch — compare against merge-base with main
                MERGE_BASE=$(git merge-base HEAD main 2>/dev/null || echo "")
                if [ -n "$MERGE_BASE" ]; then
                    CHANGED=$(git diff --name-only "$MERGE_BASE..$local_oid" 2>/dev/null || echo "")
                else
                    CHANGED=""  # fallback: run tests to be safe
                fi
            else
                CHANGED=$(git diff --name-only "$remote_oid..$local_oid" 2>/dev/null || echo "")
            fi

            # Check if any script files changed
            if echo "$CHANGED" | grep -qE '\.(sh|ps1)$'; then
                echo ""
                echo "=== Pre-push: script changes detected — running full CI suite ==="
                
                # Check for sed -i compatibility (must be sed -i '')
                if grep -r "sed -i " . --include=*.sh | grep -v "sed -i ''"; then
                    echo "[ERROR] Invalid sed -i usage found. macOS/BSD requires sed -i ''."
                    exit 1
                fi
                
                echo "  Target: $remote_ref"
                echo "  Changed scripts:"
                echo "$CHANGED" | grep -E '\.(sh|ps1)$' | sed 's/^/    - /'
                echo ""

                # Run shellcheck on changed .sh files
                SH_FILES=$(echo "$CHANGED" | grep -E '\.sh$' | tr '\n' ' ')
                if [ -n "$SH_FILES" ]; then
                    if command -v shellcheck &>/dev/null; then
                        echo ">>> Running shellcheck on changed scripts <<<"
                        if ! shellcheck --severity=warning $SH_FILES; then
                            echo ""
                            echo "[FAIL] Shellcheck reported warnings. Push aborted."
                            echo "Fix the issues above or run: shellcheck $SH_FILES"
                            echo "To skip (not recommended): git push --no-verify"
                            exit 1
                        fi
                        echo "Shellcheck: no issues found"
                    else
                        echo "[WARN] shellcheck not installed — skipping lint"
                    fi
                fi
            else
                echo "=== Pre-push: no script changes (*.sh, *.ps1) — CI skipped ==="
                echo "  Target: $remote_ref"
                echo ""
                exit 0
            fi

            if [ ! -f "tests/run_tests.sh" ]; then
                echo "[ERROR] tests/run_tests.sh not found — cannot run CI."
                exit 1
            fi

            chmod +x tests/run_tests.sh

            # Run all Docker-based tests
            for TARGET in ubuntu fedora arch powershell; do
                echo ""
                echo ">>> Running test: $TARGET <<<"
                if ! ./tests/run_tests.sh "$TARGET"; then
                    echo ""
                    echo "[FAIL] Test '$TARGET' failed."
                    echo "Push aborted. Fix the issue and try again."
                    echo "To skip (not recommended): git push --no-verify"
                    exit 1
                fi
            done

            echo ""
            echo "=== All CI tests passed. Push OK. ==="
            echo ""
            ;;
    esac
done

exit 0
