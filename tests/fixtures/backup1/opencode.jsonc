{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "sk-ant-user-personal-key-from-backup"
      }
    }
  },
  "mcpServers": {
    "user-custom-mcp": {
      "type": "stdio",
      "command": ["node", "/home/user/.local/share/mcps/user-custom-mcp/index.js"]
    },
    "fetch": {
      "type": "stdio",
      "command": ["uvx", "mcp-server-fetch"]
    }
  },
  "plugin": ["oh-my-opencode", "opencode-mem"],
  "field_from_backup": "user-customized-value-12345"
}
